# ── 隐私：绝对不发布 ──────────────────────────────
# 每个 QQ 用户一个分区：openid、她记得的事、心情、聊天偏好
users/
# QQ 收到的图/歌（可能是私人照片、私人文件）
media/
# 工作区是 bootstrap 生成的，里面带本机绝对路径
workspace/
# 日志里有对话内容、本机路径、可能还有对方的 openid
logs/
# 运行状态（心跳、缓存、队列；图库标签里带绝对路径）
state/
# 旧版本代码备份
backup/

# ── 内容不适合公开 ────────────────────────────────
# 网上抓来的表情图（版权 & 内容都不可控），只保留她自制的卡
library/*
!library/composed/
!library/composed/**

# ── 系统/构建产物 ─────────────────────────────────
__pycache__/
*.pyc
.DS_Store
.venv/

# 她的沙箱工作区 = core 本身，这些生成的/运行中的东西别提交
/AGENTS.md
/mood_request.json
/workspace/
/.outbox/
